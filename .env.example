# OpenRouter (必須 — 自分で取得して埋める)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 使う AI モデル（省略時は google/gemini-3.1-flash-lite）
# モデル一覧: https://openrouter.ai/models
# 例: もっと安く → google/gemini-2.5-flash-lite / もっと賢く → google/gemini-3.7-flash
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# 用途別に変えたいときだけ設定（省略時は OPENROUTER_MODEL を使う）
# OPENROUTER_MODEL_EXTRACT=
# OPENROUTER_MODEL_CHAT=

# Database (PostgreSQL)
# docker compose 使用時: compose が自動で上書きするので変更不要
# ホストから直接 pnpm dev/db:migrate を動かす場合は以下を使う
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
